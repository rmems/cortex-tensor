/target

# Cargo lockfile (for library projects)
Cargo.lock

# IDE / AI agent configuration and caches (do not commit local editor or agent state)
.codex/
.kilo/
.mimocode/
.cursor/
.vscode/
.idea/
.claude/
.aider*/
.roo/
.continue/

# Windsurf (already present)
.windsurf/

# OLMo model weights and folders
gguf-checkpoints/
moe-fixtures/
*.gguf

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local env and secrets (never commit)
.env
.env.local
.env.*.local
*.pem
*.key

# Build / test artifacts not covered by /target
*.log
*.tmp
tmp/
cache/
lcov.info
